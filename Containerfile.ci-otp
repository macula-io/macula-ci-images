# macula-ci-otp — the BUILD image for the ERLANG services (rebar3), as
# distinct from macula-ci-pq which carries Elixir for the mix ones.
#
# > This exists so no pipeline builds OpenSSL or OTP from source, and so the
# > Erlang services build on the OTP version the team actually standardised on.
#
# ⚠ OTP 28.4.3, the team standard since 2026-09-23. It moved from 28.4.2
# because hexpm publishes new dated Debian bases only for the newest patch of
# each OTP minor: 28.4.2 stopped at trixie-20260610, so staying on it meant
# never taking another Debian security update. Any other OTP is drift, and the
# build below refuses to finish on one.
#
# ⚠ TRIXIE IS LOAD-BEARING. The 11.x wire signs with ML-DSA-87/ML-KEM, which
# arrived in OpenSSL 3.5. Bookworm ships 3.0, where the crypto NIF dies with
# evp.c "Bad key type" on the first PQ keygen. hexpm publishes the trixie
# variant of this OTP; check the tag exists before bumping.
ARG OTP_VERSION=28.4.3
ARG DEBIAN_VERSION=trixie-20260918-slim

# ⚠ EVERY TOOL IN THE RELEASE PATH IS PINNED EXACTLY, and the build refuses
# to finish on anything else. This image builds and publishes releases, and
# we lost a hex publish to an unpinned tool (rebar3_hex 7.3.0) that moved
# under us overnight. Both of these used to float: rust followed `stable'
# and rebar3 came from S3's unversioned latest, so any rebuild could change
# the compiler every consumer builds with, with no commit anywhere.
# Bump one by editing it here, in its own commit, with the reason.
ARG REBAR3_VERSION=3.27.0
# sha256 of the release asset erlang/rebar3 publishes for REBAR3_VERSION
# (GitHub's own asset digest); must change together with it.
ARG REBAR3_SHA256=af85aab41f9fd74bdd6341ebdf6fe9c88077aab9f8eac82371583fa02f2b0bdf
ARG RUST_VERSION=1.98.1
# rustup's installer, pinned like rebar3: the exact rustup-init release,
# checked against the sha256 rust-lang publishes beside it
# (static.rust-lang.org/rustup/archive/<version>/x86_64-unknown-linux-gnu/
# rustup-init.sha256). It used to be piped from sh.rustup.rs unchecked, so a
# rustup release or a compromised host changed every image with no commit
# here. Change the two together.
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_INIT_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71

FROM docker.io/hexpm/erlang:${OTP_VERSION}-debian-${DEBIAN_VERSION}

ARG OTP_VERSION
ARG REBAR3_VERSION
ARG REBAR3_SHA256
ARG RUST_VERSION
ARG RUSTUP_VERSION
ARG RUSTUP_INIT_SHA256

RUN apt-get update -y && apt-get install -y --no-install-recommends \
      build-essential \
      git \
      curl \
      ca-certificates \
      pkg-config \
      libssl-dev \
      openssl \
      cmake \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/log/apt/* /var/log/dpkg.log /var/log/alternatives.log \
              /var/cache/ldconfig/aux-cache /var/cache/debconf/*-old

# Rust, because several macula deps are NIFs with no Erlang fallback:
# macula_quic refuses to compile without a toolchain and says so.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
# rustup downloads the components concurrently and lists them in
# rustlib/components in the order they finish, so the layer changed from build
# to build. Sorted, it is the same bytes every time; the check after it proves
# rustup still reads the sorted file and sees exactly these components.
RUN curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rm /tmp/rustup-init \
    && rustup --version 2>/dev/null | grep -qF "rustup ${RUSTUP_VERSION} " \
    && chmod -R a+w "$RUSTUP_HOME" "$CARGO_HOME" \
    && components="$(rustc --print sysroot)/lib/rustlib/components" \
    && sort -o "$components" "$components" \
    && [ "$(rustup component list --installed | tr '\n' ' ')" = \
         "cargo-x86_64-unknown-linux-gnu rust-std-x86_64-unknown-linux-gnu rustc-x86_64-unknown-linux-gnu " ] \
    && rustc --version | grep -qF "rustc ${RUST_VERSION} " \
    && cargo --version | grep -qF "cargo ${RUST_VERSION} " \
    && rustc --version && cargo --version

# rebar3 from its exact release asset, checked against its sha256, so a
# changed or substituted binary fails the build rather than shipping.
RUN curl -fsSL -o /usr/local/bin/rebar3 \
      "https://github.com/erlang/rebar3/releases/download/${REBAR3_VERSION}/rebar3" \
    && echo "${REBAR3_SHA256}  /usr/local/bin/rebar3" | sha256sum -c - \
    && chmod +x /usr/local/bin/rebar3 \
    && rebar3 version | grep -qF "rebar ${REBAR3_VERSION} " \
    && rebar3 version

# Refuse to ship an image that cannot do the one thing it exists for. An image
# that silently lost ML-DSA would take every consumer's CI green while the wire
# fails, which is this estate's signature failure.
RUN openssl version \
    && erl -noshell -eval 'io:format("~s", [element(2, file:read_file(filename:join([code:root_dir(), "releases", erlang:system_info(otp_release), "OTP_VERSION"])))]), halt().' \
      | grep -qx "${OTP_VERSION}" \
    && erl -noshell -eval 'io:format("OTP ~s~n",[erlang:system_info(otp_release)]),halt().' \
    && erl -noshell -eval 'case lists:member(mldsa87, crypto:supports(public_keys)) of \
         true -> io:format("mldsa87 ok~n"), halt(0); \
         false -> io:format("mldsa87 MISSING~n"), halt(1) end.'

LABEL org.opencontainers.image.source=https://github.com/macula-io/macula-ci-images
LABEL org.opencontainers.image.description="Macula CI build image for Erlang/rebar3 services: OTP 28.4.3 on Debian trixie with OpenSSL 3.5+ (ML-DSA), rebar3 3.27.0 and Rust 1.98.1, all pinned exactly"
