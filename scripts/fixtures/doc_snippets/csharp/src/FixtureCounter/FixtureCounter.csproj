<Project Sdk="Microsoft.NET.Sdk">

  <!-- A counter, so the self-test has a published API to call. Deliberately
       plain: no package, no dependency, nothing to restore but the framework. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FixtureCounter</RootNamespace>
  </PropertyGroup>

</Project>
