ARG B_SHA512=0
FROM x
ARG B_SHA512
RUN curl -fsSL -o /tmp/a.tgz https://example.org/a.tgz \
    && echo "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  /tmp/a.tgz" | sha256sum -c - \
    && tar xf /tmp/a.tgz
RUN wget -q -o /tmp/log -O /tmp/b.bin https://example.org/b \
    && echo "${B_SHA512}  /tmp/b.bin" | sha512sum -c -
RUN apt-get update && apt-get install -y curl || true
